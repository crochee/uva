# Generated by Cargo
target/
debug/
release/

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
**/mutants.out*/

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/
.env
config.yaml
node_modules
dist
.sdd/
.worktrees/

# Uva runtime files
**/.agents/
**/.uva/
# Content-addressed attachment store the server writes at boot
# (`AttachmentStore::new_fs(workspace_root.join(".attachments"))`).
# Runtime state, like the session logs above.
**/.attachments/
*.jsonl
*.log
.omc
.claude
.trae
.git/
openspec
docs/superpowers
docs/codex-borrowable-checklist.md
research/
.om*
.superpowers/

# Vite / vitest scratch (regenerated by the dev server)
.vite/

# `embed-web` staging: build.rs copies `uva-web/dist` here.
crates/uva-app-server/web-dist/
# Desktop shell build inputs: the Tauri sidecar staging copy (the
# bundler wants a target-triple suffix) and tauri's generated schemas.
# `desktop/dist` is already covered by the repo-wide `dist` pattern.
desktop/src-tauri/binaries/
desktop/src-tauri/gen/

# Playwright MCP session artifacts (AI-tool state, not project assets)
.playwright-mcp/

# Local markdown issue tracker (see docs/agents/issue-tracker.md) — local work
# state, not a project asset.
.scratch/
